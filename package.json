{
  "name": "indodhobi-monorepo",
  "version": "1.0.0",
  "description": "IndoDhobi - Production-Ready Indian Laundry, Washing & Ironing Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently --kill-others-on-fail -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "NODE_ENV=production npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "test:connectivity": "node --test tests/connectivity.test.mjs client/tests/apiRecovery.test.mjs client/tests/bookingDraft.test.mjs",
    "test:contracts": "node --test tests/catalogContract.test.mjs"
  },
  "keywords": ["indodhobi", "laundry", "mern", "ironing", "dry-clean", "razorpay"],
  "author": "IndoDhobi Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
