{
  "name": "indodhobi-monorepo",
  "version": "1.0.0",
  "description": "IndoDhobi - Production-Ready Indian Laundry, Washing & Ironing Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently --kill-others-on-fail -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "NODE_ENV=production npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm run test:acceptance",
    "test:connectivity": "node --test tests/connectivity.test.mjs client/tests/apiRecovery.test.mjs client/tests/bookingDraft.test.mjs client/tests/addressBook.test.mjs",
    "test:contracts": "node --test tests/catalogContract.test.mjs",
    "test:admin-content": "node --test server/tests/*.test.mjs",
    "migrate:website": "node server/scripts/migrateWebsite.js",
    "test:cache": "node --test client/tests/resourceCache.test.mjs client/tests/basketReconciliation.test.mjs client/tests/orderTracking.test.mjs",
    "test:acceptance": "npm run test:connectivity && npm run test:contracts && npm run test:cache && npm run test:admin-content"
  },
  "keywords": [
    "indodhobi",
    "laundry",
    "mern",
    "ironing",
    "dry-clean",
    "razorpay"
  ],
  "author": "IndoDhobi Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
